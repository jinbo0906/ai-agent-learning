# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# attest check 会扫描证据目录里的密钥泄漏——但别依赖它，别把 key 贴进笔记。

# ============================================================
# Judge 用的模型（任何 OpenAI 兼容端点）
# 全书评估约 90 次调用，成本目标 < 60 元
# ============================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/v1
LLM_MODEL=deepseek-v3-0324

# 计价（元 / 百万 token）—— 用于预算护栏和成本统计
# 请按你的实际服务商价目表填；填错只影响统计，不影响功能
LLM_PRICE_IN_CNY_PER_M=2.0
LLM_PRICE_OUT_CNY_PER_M=8.0

# 预算护栏（方案 §5.8：20 行代码，不需要预算账本）
# 累计花费超过它时，attest 拒绝再发起 LLM 调用
ATTEST_BUDGET_CNY=60

# ============================================================
# 章节实验用的 Key（按需填）
# ============================================================
# 第 1/2/4/5/10 章：任一 OpenAI 兼容服务即可，可直接复用上面的 LLM_*
# 若实验项目要求特定厂商变量名，在这里补：
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# 第 9 章：streaming-speech 需要 OpenAI 直连（whisper-1 / tts-1）
# OpenRouter 无音频端点，无法回退 —— 见 evidence/ch09/report.md 的决策树
OPENAI_API_KEY=

# 第 7 章：无本地 GPU 时用云端（AutoDL / Colab），此处留空即可
HF_TOKEN=

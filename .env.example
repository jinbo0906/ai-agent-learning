# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# attest check 会扫描证据目录里的密钥泄漏——但别依赖它，别把 key 贴进笔记。

# ---- Judge 用的模型（推荐国内直连，便宜且稳定）----
# 全书评估成本预估 20–60 元人民币（约 90 次调用）
ATTEST_JUDGE_PROVIDER=zhipu          # zhipu | moonshot | deepseek | siliconflow | openai
ATTEST_JUDGE_MODEL=glm-4.6
ATTEST_JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ATTEST_JUDGE_API_KEY=

# 预算护栏（方案 §5.8：20 行代码解决，不需要预算账本）
ATTEST_MONTHLY_BUDGET_CNY=50

# ---- 章节实验用的 Key（按需填）----
# 第 1/2/4/5/10 章：任一国内厂商即可
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# 第 9 章：streaming-speech 需要 OpenAI 直连（whisper-1 / tts-1）
# OpenRouter 无音频端点，无法回退 —— 见 evidence/ch09/report.md 的决策树
OPENAI_API_KEY=

# 第 7 章：无本地 GPU 时用云端（AutoDL / Colab），此处留空即可
HF_TOKEN=
